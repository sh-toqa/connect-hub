# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored - never commit real secrets.
#
# Local dev: load these into your shell before running the app, e.g.
#   set -a && source backend/.env && set +a && mvn -f backend spring-boot:run
# ...or paste them into your IDE's run configuration environment variables.
#
# Production: set these as real environment variables on your host/platform
# (Docker env, Railway/Render/AWS config vars, etc.) - do not ship this file.

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=connecthub
SQL_USERNAME=root
SQL_PASSWORD=changeme

# JWT signing key - REQUIRED, no default.
# Generate a strong one with: openssl rand -base64 64
APP_JWT_SECRET=

# Optional overrides
APP_JWT_EXPIRATION_MS=86400000
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
APP_UPLOAD_DIR=uploads
SERVER_PORT=8080


export DB_USERNAME=sa
export DB_PASSWORD=

export SQL_USERNAME=root
export SQL_PASSWORD=123
