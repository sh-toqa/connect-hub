@startuml ConnectHub_Activity_BlockUser
start
:User clicks Block;
:POST /friendships/block/{targetId} (Bearer JWT);
if (JWT valid?) then (no)
  :Return 401 Unauthorized;
  stop
else (yes)
endif
if (Target user exists?) then (no)
  :Return 404 Not Found;
  stop
else (yes)
endif
:Check for existing Friendship;
if (Friendship exists?) then (yes)
  :Update status to BLOCKED;
  :Set requester to blocker;
else (no)
  :Create new Friendship (status=BLOCKED);
endif
:Persist to database;
:Return 200 OK + FriendshipDto;
:User is blocked;
stop
@enduml