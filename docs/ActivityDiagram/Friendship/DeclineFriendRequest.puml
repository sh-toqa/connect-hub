@startuml ConnectHub_Activity_DeclineFriendRequest
start
:User clicks Decline on pending request;
:DELETE /friendships/{friendshipId}/decline (Bearer JWT);
if (JWT valid?) then (no)
  :Return 401 Unauthorized;
  stop
else (yes)
endif
:Fetch Friendship by friendshipId;
if (Friendship exists?) then (no)
  :Return 404 Not Found;
  stop
else (yes)
endif
if (User is the receiver?) then (no)
  :Return 403 Forbidden;
  stop
else (yes)
endif
:Delete Friendship from database;
:Return 204 No Content;
:Request removed from UI;
stop
@enduml