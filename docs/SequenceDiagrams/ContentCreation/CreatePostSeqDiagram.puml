@startuml ConnectHub_Sequence_CreatePost
actor User
participant "React Frontend" as FE
participant "ContentController" as CC
participant "ContentService" as CS
participant "StorageService" as SS
participant "ContentRepository" as CR
database "MySQL" as DB

User -> FE: Write post (text + optional image)
FE -> CC: POST /content/posts (Bearer JWT)
CC -> CS: createPost(authorId, request, image)
CS -> CS: createContent(authorId, text, imagePath, POST)
alt image present
  CS -> SS: store(file, "posts")
  SS --> CS: imagePath
end
CS -> CR: save(content)
CR -> DB: INSERT INTO content
DB --> CR: saved Content
CR --> CS: Content entity
CS --> CC: ContentDto
CC --> FE: 201 Created + ContentDto
FE --> User: Post appears in feed
@enduml