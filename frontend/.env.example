# Copy this file to .env and fill in real values. .env is gitignored.

# Set to your mock-mode flag if the app supports mocked API responses locally
VITE_USE_MOCK=false

# Backend base URL. Point this at your deployed backend origin in
# staging/production (e.g. https://api.yourdomain.com).
VITE_API_BASE_URL=http://localhost:8080
